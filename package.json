{
  "name": "armelis-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Application Security Intelligence for AI-Assisted Teams & SOC Analysts",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "armelis": "node bin/armelis.js",
    "scan": "node bin/armelis.js scan",
    "trace": "node bin/armelis.js trace",
    "break": "node bin/armelis.js break",
    "test": "npm --prefix packages/scanner-adapters/trivy test",
    "build:web": "npm --prefix apps/web run build",
    "pack:cli": "npm pack --workspace=armelis",
    "publish:cli": "npm publish --workspace=armelis --access public"
  },
  "author": "Johan Vasquez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Johanvasquezdev/armelis.git"
  },
  "homepage": "https://github.com/Johanvasquezdev/armelis#readme",
  "bugs": {
    "url": "https://github.com/Johanvasquezdev/armelis/issues"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "packageManager": "npm@10.8.2"
}
