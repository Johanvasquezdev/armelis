{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hopchain",
  "version": "0.1.0",
  "identifier": "dev.johanvasquez.hopchain",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Hopchain Local",
      "width": 1100,
      "height": 800,
      "minWidth": 360,
      "minHeight": 600,
      "resizable": true
    }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:1420 ws://localhost:1420; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
