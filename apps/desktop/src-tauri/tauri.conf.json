{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Armelis",
  "version": "0.1.4",
  "identifier": "dev.johanvasquez.armelis",
  "build": {
    "beforeDevCommand": "cmd /c npm run dev",
    "beforeBuildCommand": "cmd /c npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Armelis — Application Security Command",
      "width": 1120,
      "height": 820,
      "minWidth": 360,
      "minHeight": 600,
      "resizable": true
    }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:1420 ws://localhost:1420; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Johan Vasquez",
    "shortDescription": "Application Security Intelligence & Choke-Point Defense",
    "longDescription": "Armelis maps reachability attack paths from public entry points to crown-jewel assets, isolating the single choke point that eliminates exposure.",
    "copyright": "Copyright © 2026 Johan Vasquez. MIT License.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English", "Spanish"],
        "displayLanguageSelector": false
      }
    }
  }
}
